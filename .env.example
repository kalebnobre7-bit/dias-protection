# Copie para .env.local (dev) e configure as mesmas variáveis na Vercel e nas "Variables" do repositório no GitHub.
# A anon key é pública por desenho: quem protege os dados é o RLS + Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Só para scripts/import-json.mjs (nunca vai para o navegador nem para o git)
SUPABASE_SERVICE_ROLE_KEY=
